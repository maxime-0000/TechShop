{% extends 'base.html.twig' %}

{% block title %}Panier | TechShop{% endblock %}

{% block body %}
<main class="container py-5">

    <h1>Votre panier</h1>

    {% if produits is empty %}

        <p>Votre panier est vide pour le moment.</p>

    {% else %}

        <table class="table text-white">
            <thead>
                <tr>
                    <th>Produit</th>
                    <th>Prix</th>
                </tr>
            </thead>

            <tbody>
                {% for produit in produits %}
                    <tr>
                        <td>{{ produit.nom }}</td>
                        <td>{{ produit.prix|number_format(2, ',', ' ') }} €</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>

        <h2>Total : {{ total|number_format(2, ',', ' ') }} €</h2>

    {% endif %}

    <a href="{{ path('catalogue') }}">Découvrir le catalogue</a>

</main>
{% endblock %}