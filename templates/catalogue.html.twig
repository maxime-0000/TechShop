
{% extends 'base.html.twig' %}

{% block title %}Catalogue | TechShop{% endblock %}

{% block body %}
<main class="catalogue">
    <section class="catalogue-intro">
        <h1>Le catalogue TechShop</h1>
        <p>Découvrez une sélection de produits high-tech pour vous accompagner au quotidien. Que vous cherchiez un nouvel appareil, un accessoire pratique ou une idée cadeau, trouvez l’équipement qui vous correspond.</p>
        <p>Prenez le temps de comparer les caractéristiques et choisissez en toute simplicité. Notre équipe reste à votre écoute pour vous aider à faire le bon choix.</p>
    </section>
    <section aria-label="Produits du catalogue">
        {% if produits is empty %}
            <p>Aucun produit n’est disponible pour le moment.</p>
        {% else %}
            <div class="catalogue-grid">
                {% for produit in produits %}
                    <article class="carte">
                        {% if produit.imageUrl %}
                            <img
                                class="carte-image"
                                src="{{ produit.imageUrl }}"
                                alt="Image du produit {{ produit.nom }}"
                                loading="lazy"
                                referrerpolicy="no-referrer"
                            >
                        {% endif %}

                        <h2>{{ produit.nom }}</h2>
                        <p class="carte-description">{{ produit.description }}</p>
                        <p class="carte-prix">{{ produit.prix|number_format(2, ',', ' ') }} €</p>

                        <p class="carte-stock" data-out-of-stock="{{ produit.quantite <= 0 ? 'true' : 'false' }}">
                            {% if produit.quantite > 0 %}
                                {{ produit.quantite }} en stock
                            {% else %}
                                Rupture de stock
                            {% endif %}
                        </p>
                    </article>
                {% endfor %}
            </div>
        {% endif %}
    </section>
</main>
{% endblock %}
